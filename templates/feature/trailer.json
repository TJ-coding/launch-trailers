{
  "type": "feature",
  "title": "Acme: new feature",
  "promise": "Write what existing users can now do.",
  "format": "landscape",
  "fps": 30,
  "silent": true,
  "transition": "cut",
  "theme": {
    "bg": "#F2F0EB",
    "fg": "#101216",
    "accent": "#2563EB",
    "accent2": "#F2B632",
    "font": "Sora"
  },
  "brand": {
    "name": "Acme",
    "logo": "logo.png",
    "url": "acme.dev"
  },
  "scenes": [
    {
      "type": "demo",
      "duration": 3.2,
      "bg": "paper",
      "layout": "left",
      "tilt": true,
      "brandMark": true,
      "headline": "can now\n[do X].",
      "media": "feature.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.4,
          "scale": 1.5
        }
      ]
    },
    {
      "type": "demo",
      "duration": 4.8,
      "layout": "full",
      "media": "use.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "startFrom": 1.0,
      "prompt": {
        "label": "Just ask.",
        "text": "What the person types",
        "at": 0.45,
        "until": 2.2
      },
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.5,
          "scale": 1.3
        },
        {
          "at": 2.2,
          "x": 0.5,
          "y": 0.5,
          "scale": 1.3
        },
        {
          "at": 2.9,
          "x": 0.5,
          "y": 0.5,
          "scale": 2.0
        }
      ]
    },
    {
      "type": "demo",
      "duration": 4.2,
      "bg": "accent",
      "layout": "right",
      "headline": "Done in\n[one step].",
      "media": "result.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.4,
          "scale": 1.7
        }
      ]
    },
    {
      "type": "end",
      "duration": 4.4,
      "headline": "Now in [Acme].",
      "button": "Try it now",
      "media": "result.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.35,
          "scale": 1.2
        }
      ]
    }
  ]
}

{
  "type": "product",
  "title": "Acme: launch film",
  "promise": "Write the one sentence the viewer should believe afterwards.",
  "format": "landscape",
  "fps": 30,
  "silent": true,
  "transition": "cut",
  "theme": {
    "bg": "#F2F0EB",
    "fg": "#101216",
    "accent": "#2563EB",
    "accent2": "#F2B632",
    "font": "Sora"
  },
  "brand": {
    "name": "Acme",
    "logo": "logo.png",
    "url": "acme.dev"
  },
  "scenes": [
    {
      "type": "demo",
      "duration": 3.4,
      "bg": "paper",
      "layout": "left",
      "tilt": true,
      "brandMark": true,
      "headline": "does the thing\nyou [need].",
      "media": "home.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.35,
          "scale": 1.3
        }
      ]
    },
    {
      "type": "demo",
      "duration": 4.6,
      "layout": "full",
      "media": "ask.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "startFrom": 1.0,
      "prompt": {
        "label": "Just type it.",
        "text": "What the person types",
        "at": 0.45,
        "until": 2.2
      },
      "view": [
        {
          "at": 0,
          "x": 0.6,
          "y": 0.6,
          "scale": 1.3
        },
        {
          "at": 2.2,
          "x": 0.6,
          "y": 0.6,
          "scale": 1.3
        },
        {
          "at": 2.9,
          "x": 0.6,
          "y": 0.5,
          "scale": 2.1
        }
      ]
    },
    {
      "type": "demo",
      "duration": 5.4,
      "bg": "accent",
      "layout": "left",
      "headline": "It does\n[the work].",
      "media": "work.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "playbackRate": 1.5,
      "view": [
        {
          "at": 0,
          "x": 0.4,
          "y": 0.4,
          "scale": 1.6
        }
      ],
      "check": true,
      "steps": [
        {
          "text": "First result",
          "at": 1.0
        },
        {
          "text": "Second result",
          "at": 2.2
        },
        {
          "text": "Third result",
          "at": 3.4
        }
      ]
    },
    {
      "type": "demo",
      "duration": 4.4,
      "bg": "accent2",
      "layout": "right",
      "headline": "And you get\n[the result].",
      "media": "result.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.4,
          "scale": 1.6
        }
      ]
    },
    {
      "type": "end",
      "duration": 4.4,
      "headline": "The promise, [short].",
      "button": "Try it now",
      "media": "result.mp4",
      "mediaAspect": 1.6,
      "uiWidth": 1280,
      "view": [
        {
          "at": 0,
          "x": 0.5,
          "y": 0.35,
          "scale": 1.2
        }
      ]
    }
  ]
}
